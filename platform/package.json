{
  "name": "armonia-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./node_modules/prisma/build/index.js generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev --name init",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset": "node ./node_modules/prisma/build/index.js db push --force-reset --accept-data-loss && node --experimental-strip-types prisma/seed.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
